# Webbhotellet (Apache bakom nginx). Deployas med resten av dist/ från GitHub Actions.
# HTTPS-omdirigering görs med "Force SSL" i DirectAdmin, inte här: bakom nginx-proxyn
# ser Apache alla anrop som HTTP och en villkorad omdirigering här skulle ge en loop.

Options -Indexes

# www → utan www (absolut https-mål, så ingen loop bakom nginx)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# index.php först: startsidan byggs som index.php när site.phpIndex är på (se scripts/postbuild.mjs)
DirectoryIndex index.php index.html
ErrorDocument 404 /404.html

# Textfiler (humans.txt, security.txt, robots.txt) med rätt teckenkodning för å/ä/ö
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .css .js .svg

# Säkerhetsheaders fylls i vid bygget från scripts/security-headers.mjs (scripts/postbuild.mjs)
# @security-headers
