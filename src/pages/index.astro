---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import avatar from '../assets/avatar.jpg';
import hacker from '../assets/avatar-hacker.png';
import { SITE, CONFIG, formatDate } from '../site';

// CV-länken pekar på den nyaste PDF:en i public/cv/, oavsett filnamn: först datumet i namnet
// (ÅÅÅÅ-MM-DD), annars ändringstiden. Ingen PDF, ingen länk.
// Sökvägen utgår från projektroten (där bygget körs): import.meta.url pekar på den paketerade filen, inte src/pages.
function latestCv() {
  const dir = path.join(process.cwd(), 'public', 'cv');
  if (!fs.existsSync(dir)) return null;
  const pdfs = fs.readdirSync(dir).filter((f) => f.toLowerCase().endsWith('.pdf'));
  const dated = (f) => f.match(/\d{4}-\d{2}-\d{2}/)?.[0] ?? '';
  const mtime = (f) => fs.statSync(path.join(dir, f)).mtimeMs;
  pdfs.sort((a, b) => dated(b).localeCompare(dated(a)) || mtime(b) - mtime(a));
  return pdfs[0] ? `/cv/${encodeURIComponent(pdfs[0])}` : null;
}
const cvPath = latestCv();
const hasCv = cvPath !== null;

const posts = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const { person, profile, avatar: avatarConfig, features } = CONFIG;
const showLabSection = features.lab && posts.length > 0;
// Glasögonens placering (i sudo-läge) beror på ansiktet i bilden, så den kommer från konfigurationen
const glassesStyle = [
  `--glasses-top: ${avatarConfig.glasses.top}%`,
  `--glasses-left: ${avatarConfig.glasses.left}%`,
  `--glasses-retro-top: ${avatarConfig.glassesRetro.top}%`,
  `--glasses-retro-left: ${avatarConfig.glassesRetro.left}%`,
].join('; ');
const lead = [person.title, person.company && `på ${person.company}`, person.location && `i ${person.location}`]
  .filter(Boolean)
  .join(' ');
---
<Base>
  <section class="hero">
    <span class="avatar-wrap" style={glassesStyle}>
      <Image src={avatar} alt={person.name} width={320} height={320} fit="cover" class="avatar" loading="eager" />
      <!-- sudo-läget: hackerversionen (scripts/make-hacker-avatar.mjs) och "deal with it"-glasögon -->
      {features.eggs && <Image src={hacker} alt="" aria-hidden="true" width={384} height={384} format="png" class="avatar avatar-hacker" loading="eager" />}
      {features.eggs && <svg class="deal-glasses" viewBox="0 0 26 7" aria-hidden="true" shape-rendering="crispEdges">
        <rect x="0" y="0" width="26" height="1" fill="#000" />
        <rect x="2" y="1" width="9" height="1" fill="#000" /><rect x="15" y="1" width="9" height="1" fill="#000" />
        <rect x="11" y="1" width="4" height="1" fill="#000" />
        <rect x="3" y="2" width="7" height="1" fill="#000" /><rect x="16" y="2" width="7" height="1" fill="#000" />
        <rect x="4" y="3" width="5" height="1" fill="#000" /><rect x="17" y="3" width="5" height="1" fill="#000" />
        <rect x="3" y="1" width="1" height="1" fill="#fff" /><rect x="4" y="2" width="1" height="1" fill="#fff" />
        <rect x="16" y="1" width="1" height="1" fill="#fff" /><rect x="17" y="2" width="1" height="1" fill="#fff" />
      </svg>}
    </span>
    <div>
      <h1>{person.name}</h1>
      <p class="lead">{lead}.</p>
      <p class="links">
        {SITE.links.map((l) => <a href={l.href} rel="me">{l.label}</a>)}
        <a href={`mailto:${SITE.email}`}>E-post</a>
        {hasCv && <a href={cvPath}>CV (PDF)</a>}
      </p>
    </div>
  </section>

  <section>
    {profile.intro.map((text) => <p>{text}</p>)}
  </section>

  <section>
    <h2>{profile.focusHeading}</h2>
    <ul class="focus">
      {profile.focus.map((f) => <li><strong>{f.title}</strong><span>{f.text}</span></li>)}
    </ul>
    {profile.clients.length > 0 && (
      <p class="muted">
        Uppdrag i urval: {profile.clients.join(' · ')}.
        {SITE.links[0] && <> Fullständig historik finns på <a href={SITE.links[0].href}>{SITE.links[0].label}</a>.</>}
      </p>
    )}
  </section>

  {showLabSection && (
    <section>
      <h2>Senast i labbet</h2>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a href={`/lab/${p.id}/`}>{p.data.title}</a>
            <time class="muted" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          </li>
        ))}
      </ul>
      <p><a href="/lab/">Alla anteckningar →</a></p>
    </section>
  )}
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 160px 1fr; gap: 1.5rem; align-items: center;
    margin: 1rem 0 2rem;
  }
  .avatar-wrap { position: relative; display: block; width: 160px; height: 160px; }
  .avatar { width: 160px; height: 160px; border-radius: 50%; object-fit: cover; }
  .avatar-hacker, .deal-glasses { display: none; }
  .avatar-hacker { image-rendering: pixelated; }
  :global(:root.sudo) .avatar-wrap .avatar { display: none; }
  :global(:root.sudo) .avatar-wrap .avatar-hacker { display: block; }
  .deal-glasses {
    position: absolute;
    left: var(--glasses-left, 30%);
    top: var(--glasses-top, 47%);
    width: 42%;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }
  :global(:root.sudo) .deal-glasses { display: block; animation: deal-drop 1.1s cubic-bezier(0.3, 1.35, 0.5, 1) both; }
  @keyframes deal-drop { from { transform: translateY(-420%); opacity: 0; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(:root.sudo) .deal-glasses { animation: none; } }
  h1 { font-size: 2.1rem; margin: 0; }
  .lead { margin: 0.25rem 0 0.75rem; color: var(--muted); font-size: 1.1rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; }
  .focus { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .focus li { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 0.9rem 1rem; }
  .focus strong { display: block; }
  .focus span { color: var(--muted); font-size: 0.95rem; }
  .posts { list-style: none; padding: 0; }
  .posts li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.4rem 0; border-bottom: 1px solid var(--line); }
  .posts time { white-space: nowrap; font-size: 0.9rem; }
  @media (max-width: 560px) {
    .hero { grid-template-columns: 1fr; }
    .avatar, .avatar-wrap { width: 120px; height: 120px; }
    .focus { grid-template-columns: 1fr; }
    .posts li { flex-direction: column; gap: 0; }
  }
</style>
