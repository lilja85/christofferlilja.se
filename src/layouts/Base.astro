---
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/profil-avatar.jpg';
import { SITE } from '../site';
import '../styles/retro.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${SITE.name} – ${SITE.title} i ${SITE.location}.` } = Astro.props;
const pageTitle = title ? `${title} – ${SITE.name}` : `${SITE.name} – ${SITE.title}`;
const ogImage = await getImage({ src: avatar, width: 1200, height: 1200, format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site);

// Labbinläggen skickas med som data så att den hemliga terminalen kan köra "ls lab"
const labData = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({ title: p.data.title, date: p.data.date.toISOString().slice(0, 10), url: `/lab/${p.id}/` }));
---
<!doctype html>
<!--
   Hej, du som läser källkod! 👋
   Tryck "." på sidan, prova ↑ ↑ ↓ ↓ ← → ← → B A, eller öppna konsolen.
-->
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="author" href="/humans.txt" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    {SITE.links.map((l) => <link rel="me" href={l.href} />)}
    <!-- Sätter temat innan sidan ritas så att den inte blinkar till i fel färg -->
    <script is:inline src="/js/theme-init.js"></script>
    <script is:inline src="/js/site.js" defer></script>
    <script is:inline src="/js/retro.js" defer></script>
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="brand">{SITE.name}</a>
      <nav>
        <a href="/">Om mig</a>
        <a href="/lab/">Lab</a>
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Byt till mörkt tema" title="Byt tema">
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" /></svg>
        </button>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script type="application/json" id="lab-data" set:html={JSON.stringify(labData)} />
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --fg: #1d1d1f;
    --muted: #5f6368;
    --line: #e4e1dc;
    --accent: #1f6f5c;
    --card: #ffffff;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']):not([data-theme='2008']) {
      --bg: #141517;
      --fg: #ececec;
      --muted: #a0a4ab;
      --line: #2c2e33;
      --accent: #5cc5a7;
      --card: #1b1c1f;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #141517;
    --fg: #ececec;
    --muted: #a0a4ab;
    --line: #2c2e33;
    --accent: #5cc5a7;
    --card: #1b1c1f;
    color-scheme: dark;
  }
  /* sudo-läge (Konami-koden): tidsbegränsad förhöjd behörighet, precis som PIM */
  :root.sudo {
    --bg: #020703;
    --fg: #39ff6a;
    --muted: #22b24a;
    --line: #0e3a1a;
    --accent: #9dffb6;
    --card: #04110a;
    --font: ui-monospace, 'Cascadia Code', Consolas, monospace;
    color-scheme: dark;
  }
  :root.sudo body { text-shadow: 0 0 6px rgb(57 255 106 / 0.35); }
  :root.sudo img { filter: grayscale(1) sepia(1) hue-rotate(70deg) saturate(3); }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 17px/1.6 var(--font);
    transition: background-color 0.2s, color 0.2s;
  }
  a { color: var(--accent); text-underline-offset: 0.15em; }
  a:hover { text-decoration-thickness: 2px; }
  h1, h2, h3 { line-height: 1.25; text-wrap: balance; }
  img { max-width: 100%; height: auto; }
  code, pre { font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.9em; }
  pre { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1rem; overflow-x: auto; }
  .wrap { max-width: 44rem; margin: 0 auto; padding: 0 16px; }
  .muted { color: var(--muted); }
  .site-header {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding-top: 1.5rem; padding-bottom: 1.5rem;
  }
  .brand { font-weight: 650; color: var(--fg); text-decoration: none; }
  .site-header nav { display: flex; align-items: center; gap: 1.25rem; }
  .site-header nav a { color: var(--muted); text-decoration: none; }
  .site-header nav a:hover { color: var(--fg); }
  .theme-toggle {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin: -0.5rem 0;
    padding: 0; border: 1px solid var(--line); border-radius: 50%;
    background: var(--card); color: var(--muted); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--fg); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-toggle svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* Visa månen i ljust tema (klick → mörkt) och solen i mörkt tema (klick → ljust) */
  .icon-sun { display: none; }
  :root[data-theme='dark'] .icon-sun, :root.sudo .icon-sun { display: block; }
  :root[data-theme='dark'] .icon-moon, :root.sudo .icon-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']):not([data-theme='2008']) .icon-sun { display: block; }
    :root:not([data-theme='light']):not([data-theme='2008']) .icon-moon { display: none; }
  }
  .site-footer {
    margin-top: 4rem; padding-top: 1.5rem; padding-bottom: 2rem;
    border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem;
  }
  .site-footer a { color: inherit; }
  .toast {
    position: fixed; left: 50%; bottom: 1.5rem; transform: translateX(-50%);
    max-width: calc(100% - 32px); padding: 0.75rem 1rem;
    background: var(--card); color: var(--fg); border: 1px solid var(--accent); border-radius: 8px;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.9rem;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }
  .term {
    position: fixed; inset: auto 0 0 0; z-index: 50;
    height: min(60vh, 28rem); display: flex; flex-direction: column;
    background: #0b0f0c; color: #d7ffe0; border-top: 2px solid #39ff6a;
    font: 14px/1.5 ui-monospace, 'Cascadia Code', Consolas, monospace;
    box-shadow: 0 -12px 32px rgb(0 0 0 / 0.35);
    animation: term-in 0.15s ease-out;
  }
  .term[hidden] { display: none; }
  @keyframes term-in { from { transform: translateY(100%); } }
  .term-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.35rem 16px; background: #141a16; color: #7fbf8f; font-size: 0.8rem;
  }
  .term-close { background: none; border: 0; color: inherit; font-size: 1.25rem; line-height: 1; cursor: pointer; }
  .term-out { flex: 1; overflow-y: auto; padding: 0.5rem 16px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .term-out a { color: #9dffb6; }
  .term-cmd { color: #ffffff; margin-top: 0.25rem; }
  .term-dim { color: #7fbf8f; }
  .term-err { color: #ff8a80; }
  .term-log { color: #39ff6a; }
  .term-line { display: flex; gap: 0.5rem; padding: 0.4rem 16px 0.8rem; }
  .term-prompt { color: #39ff6a; }
  .term-input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: inherit; font: inherit; caret-color: #39ff6a; }
</style>
