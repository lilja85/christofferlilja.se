---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../site';

const posts = (await getCollection('lab', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Lab" description="Anteckningar från mitt homelab och andra tekniska experiment.">
  <h1>Lab</h1>
  <p class="muted">Anteckningar från mitt homelab och andra tekniska experiment. Mest för mig själv, men kanske till nytta för någon annan.</p>
  {posts.length === 0 && <p>Inga anteckningar ännu.</p>}
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`/lab/${p.id}/`}>{p.data.title}</a>
        <time class="muted" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .posts a { font-weight: 600; font-size: 1.1rem; }
  .posts time { display: block; font-size: 0.9rem; }
  .posts p { margin: 0.25rem 0 0; }
</style>
